{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="container-fluid py-5" style="max-width: 500px; margin: 0 auto;">
  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-4">
      <h3 class="fw-bold text-center mb-4" style="color:#2e2e2e;">Login</h3>

      {{ form_start(form) }}

      <!-- EMAIL -->
      <div class="mb-3">
        {{ form_label(form.email, 'Email', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
        {{ form_widget(form.email, { 'attr': {'class': 'form-control', 'placeholder': 'Enter your email'} }) }}
        {{ form_errors(form.email) }}
      </div>

      <!-- PASSWORD -->
      <div class="mb-3">
        {{ form_label(form.password, 'Password', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
        {{ form_widget(form.password, { 'attr': {'class': 'form-control', 'placeholder': 'Enter your password'} }) }}
        {{ form_errors(form.password) }}
      </div>

      <!-- LOGIN & SIGN UP buttons side by side -->
      <div class="d-flex justify-content-center gap-2 mt-3">
        <button type="submit" class="btn fw-bold"
                style="background-color:#F88F6A; color:white; border:none; border-radius:6px; padding:0.375rem 0.75rem; font-size:0.95rem;">
          Login
        </button>
        <a href="{{ path('app_user_new') }}" class="btn fw-bold"
           style="background-color:#F88F6A; color:white; border:none; border-radius:6px; padding:0.375rem 0.75rem; font-size:0.95rem;">
          Sign Up
        </a>
      </div>

      <!-- Go Back button -->
      <div class="text-center mt-3">
        <a href="{{ path('app_projects') }}" class="btn fw-bold"
           style="background-color:#F88F6A; color:white; border:none; border-radius:6px; padding:0.375rem 0.75rem; font-size:0.95rem;">
          Go Back
        </a>
      </div>

      <!-- Flash messages -->
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger mt-3">{{ message }}</div>
      {% endfor %}

      {{ form_end(form) }}
    </div>
  </div>
</div>

<style>
.card {
  background-color: #fff;
  overflow: hidden;
}

.form-label {
  color: #2e2e2e;
}

.btn:hover {
  background-color: #e37453 !important;
}

main, .main-content, .container-fluid {
  overflow: visible !important;
}
</style>
{% endblock %}
