{% extends 'base.html.twig' %}

{% block title %}InventoryLog{% endblock %}

{% block body %}
    <h1>InventoryLog</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ inventory_log.id }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ inventory_log.stock }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ inventory_log.createdAt ? inventory_log.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ActionType</th>
                <td>{{ inventory_log.actionType }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_inventory_log_index') }}">back to list</a>

    <a href="{{ path('app_inventory_log_edit', {'id': inventory_log.id}) }}">edit</a>

    {{ include('inventory_log/_delete_form.html.twig') }}
{% endblock %}
