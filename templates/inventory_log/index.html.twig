{% extends 'base.html.twig' %}

{% block title %}InventoryLog index{% endblock %}

{% block body %}
    <h1>InventoryLog index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Stock</th>
                <th>CreatedAt</th>
                <th>ActionType</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for inventory_log in inventory_logs %}
            <tr>
                <td>{{ inventory_log.id }}</td>
                <td>{{ inventory_log.stock }}</td>
                <td>{{ inventory_log.createdAt ? inventory_log.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ inventory_log.actionType }}</td>
                <td>
                    <a href="{{ path('app_inventory_log_show', {'id': inventory_log.id}) }}">show</a>
                    <a href="{{ path('app_inventory_log_edit', {'id': inventory_log.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_inventory_log_new') }}">Create new</a>
{% endblock %}
