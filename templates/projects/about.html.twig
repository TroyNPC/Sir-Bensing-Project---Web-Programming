{% extends 'headerfooter.html.twig' %}

{% block title %}Nexuscore | About{% endblock %}

 {% block feature_stylesheets %}
<link rel="stylesheet" href="{{ asset('Arrangestyle/projects/customerabout.css') }}">
{% endblock %}

{% block body %}

<!-- HERO SECTION -->
<section class="py-5 text-center" style="background: linear-gradient(135deg, #2e2e2e 50%, #F88F6A 50%); color: #fff;">
  <div class="container">
    <h1 class="display-4 fw-bold">About Nexuscore</h1>
    <p class="lead fw-semibold">Your trusted partner for computer parts, repairs, and services.</p>
  </div>
</section>

<!-- ABOUT NEXUSCORE -->
<section class="py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 mb-4 mb-md-0">
        <img src="{{ asset('nexuscore.jpg') }}" alt="Nexuscore Office" class="img-fluid rounded shadow-sm">
      </div>
      <div class="col-md-6">
        <h2 class="fw-bold text-dark mb-3">Our Story</h2>
        <p>Nexuscore is dedicated to providing high-quality computer parts and reliable repair services. We aim to make technology accessible, affordable, and convenient for everyone. Our skilled team ensures fast, dependable, and professional service for all your tech needs.</p>
        <p>Whether you visit us in-store or request door-to-door support, Nexuscore is here to keep your devices running smoothly.</p>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES / FEATURES -->
<section class="py-5 bg-light text-center">
  <div class="container">
    <h2 class="fw-bold mb-5 text-dark">Our Services</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 shadow-sm text-center p-4">
          <div class="mb-3" style="font-size: 40px; color: var(--primary-orange);"><i class="bi bi-tools"></i></div>
          <h5 class="fw-bold text-orange mb-3">In-Store Repairs</h5>
          <p>Get your devices fixed quickly and reliably at our store using top-quality parts.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm text-center p-4">
          <div class="mb-3" style="font-size: 40px; color: var(--primary-orange);"><i class="bi bi-truck"></i></div>
          <h5 class="fw-bold text-orange mb-3">Door-to-Door Service</h5>
          <p>Convenient repairs and tech support delivered straight to your home or office.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm text-center p-4">
          <div class="mb-3" style="font-size: 40px; color: var(--primary-orange);"><i class="bi bi-box-seam"></i></div>
          <h5 class="fw-bold text-orange mb-3">Premium Parts</h5>
          <p>High-quality computer components for purchase, installation, or upgrades.</p>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
