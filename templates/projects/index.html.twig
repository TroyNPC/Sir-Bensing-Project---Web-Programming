            <h5 class="card-title">Product {{ i }}</h5>
            <p class="card-text">Short description of product {{ i }}.</p>
            <p class="fw-bold text-orange">₱{{ 999 + (i * 100) }}</p>
            <a href="#" class="btn btn-orange" style="background: orange; width: 100px; height: 40px; line-height: 40px; padding: 0; text-align: center;"> View</a> 
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
