        <li class="nav-item text-white"><a class="nav-link text-white fs-6" href="#">Contact</a></li>
      </ul>

      <div class="d-flex justify-content-center justify-content-lg-end gap-2 mb-3 mb-lg-0">
        <button type="button" class="btn btn-outline-light">Login</button>
        <button type="button" class="btn" style = "background: #F88F6A">Sign-up</button>
      </div>
    </div>
  </div>
</header>

