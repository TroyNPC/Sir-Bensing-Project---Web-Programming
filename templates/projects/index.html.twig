{% extends 'headerfooter.html.twig' %}
{% block title %}Nexuscore | Home{% endblock %}

{% block content %}
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
<link rel="stylesheet" href="{{ asset('build/app.css') }}"> 

<style>
  body {
    font-family: 'Open Sans', sans-serif !important;
    overflow-x: hidden;
    background: #fff;
    color: #2e2e2e;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 700;
  }
  p, a, li, button, span {
    font-family: 'Open Sans', sans-serif !important;
  }
  :root {
    --primary-dark: #2e2e2e;
    --primary-orange: #F88F6A;
  }
  .btn-orange {
    background: var(--primary-orange);
    color: #fff;
    transition: 0.3s;
    border: none;
  }
  .btn-orange:hover {
    background: #e47654;
    color: #fff;
  }
  .text-orange { color: var(--primary-orange); }
  .card {
    border: none;
    border-radius: 15px;
    transition: all 0.3s ease;
  }
    .card-img-top {
    width: 100%;
    height: 200px;                /* Keeps consistent card height */
    object-fit: contain !important; /* Ensures full image fits inside */
    background-color: #f8f9fa;     /* Light background behind transparent images */
    border: 1px solid #ddd;        /* Adds clean border */
    border-radius: 10px;           /* Slight rounding to match card */
    padding: 5px;                  /* Adds spacing inside the frame */
    box-sizing: border-box;        /* Keeps layout consistent */
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  header.navbar { background: var(--primary-dark); }
  header .nav-link {
    color: #fff !important;
    font-weight: 500;
    transition: 0.3s;
  }
  header .nav-link:hover { color: var(--primary-orange) !important; }
  footer { background: var(--primary-dark); color: #fff; }
</style>



<!-- HERO -->
<section class="mt-0">
  <div id="imageCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner rounded-3 shadow-lg" style="height: 500px;">
      <div class="carousel-item active h-100">
        <img src="{{ asset('Repair1.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.75;">
        <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
          <h1 class="fw-bold text-dark display-5">WELCOME TO NEXUSCORE</h1>
          <p class="fs-4 text-orange fw-semibold">Computer Parts + Repair</p>
        </div>
      </div>
      <div class="carousel-item h-100">
        <img src="{{ asset('Repair2.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.75;">
        <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
          <h1 class="fw-bold text-dark display-5">YOUR TECH SOLUTION</h1>
          <p class="fs-4 text-orange fw-semibold">Fast. Reliable. Affordable.</p>
        </div>
      </div>
      <div class="carousel-item h-100">
        <img src="{{ asset('Repair3.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.75;">
        <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
          <h1 class="fw-bold text-dark display-5">AVAILABLE SERVICE BOOKING!</h1>
          <p class="fs-4 text-orange fw-semibold">Top Quality Services & Advisers</p>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" style="filter: invert(1)"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" style="filter: invert(1)"></span>
    </button>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="py-5 bg-light text-center">
  <div class="container">
    <h2 class="fw-bold mb-5 text-dark">Featured Products</h2>

    {% if featured is empty %}
      <p class="text-muted">No Featured Products in display</p>
    {% else %}
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        {% for product in featured %}
        <div class="col">
          <div class="card h-100 shadow-sm">
            {% if product.image %}
              <img src="{{ asset('uploads/products/' ~ product.image) }}" class="card-img-top" style="height: 200px; object-fit: cover;">
            {% else %}
              <div class="d-flex align-items-center justify-content-center bg-light" style="height:200px;"><span>No Image</span></div>
            {% endif %}
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title fw-semibold">{{ product.name }}</h5>
                <p class="card-text text-muted small">
                  {{ product.description|length > 80 ? product.description|slice(0,80) ~ '...' : product.description }}
                </p>
              </div>
              <div>
                <p class="fw-bold text-orange mb-2">₱{{ product.price }}</p>
                <button class="btn btn-orange w-100" data-bs-toggle="modal" data-bs-target="#viewModal{{ product.id }}">View</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Modal -->
<!-- Modal -->
<div class="modal fade" id="viewModal{{ product.id }}" tabindex="-1" aria-labelledby="viewModalLabel{{ product.id }}" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">{{ product.name }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <!-- Image Column -->
          <div class="col-md-5 text-center">
            {% if product.image %}
              <img src="{{ asset('uploads/products/' ~ product.image) }}" 
                   alt="{{ product.name }}" 
                   class="img-fluid rounded-3 shadow-sm" 
                   style="max-height:200px; object-fit:cover;">
            {% else %}
              <div class="d-flex align-items-center justify-content-center bg-light rounded-3 shadow-sm" style="height:200px;">
                <span>No Image</span>
              </div>
            {% endif %}
          </div>

          <!-- Details Column -->
          <div class="col-md-7">
            <h5 class="fw-bold text-dark mb-2">{{ product.name }}</h5>
            <p class="text-muted mb-1"><strong>Brand:</strong> {{ product.brand }}</p>
            <p class="text-muted mb-1"><strong>Category:</strong> {{ product.category }}</p>
            <p class="text-secondary mb-2"><strong>Description:</strong> {{ product.description }}</p>
            <p class="fw-bold text-orange mb-2">₱{{ product.price }}</p>
            <p class="text-muted mb-0"><strong>Available:</strong> {{ product.isavailable ? 'Yes' : 'No' }}</p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <a href="#" class="btn btn-orange w-100">Order</a>
      </div>
    </div>
  </div>
</div>

        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<!-- GALLERY -->
<section class="py-5" style="background: linear-gradient(135deg, #2e2e2e 50%, #F88F6A 50%);">
  <div class="container text-center text-white">
    <h2 class="fw-bold mb-4">Explore Our Gallery</h2>
    {% if featured|length < 2 %}
      <p>No gallery items available</p>
    {% else %}
      <div class="row g-4 justify-content-center">
        {% for product in featured|slice(0, 2) %}
        <div class="col-md-5">
          <div class="card h-100 text-center shadow-sm border-0">
            {% if product.image %}
              <img src="{{ asset('uploads/products/' ~ product.image) }}" class="card-img-top" style="height: 220px; object-fit: cover;">
            {% endif %}
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
              <h5 class="fw-bold text-dark">{{ product.name }}</h5>
              <p class="text-muted mb-2">
                {{ product.description|length > 80 ? product.description|slice(0,80) ~ '...' : product.description }}
              </p>
              <p class="fw-bold text-orange mb-2">₱{{ product.price }}</p>
              <button class="btn btn-orange px-4" data-bs-toggle="modal" data-bs-target="#viewModal{{ product.id }}">View</button>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>


<!-- OUR SERVICES & HIGHLIGHTS -->
<section class="py-5" style="background: #f5f5f5;">
  <div class="container text-center">
    <h2 class="fw-bold mb-4 text-dark">Our Services & Highlights</h2>
    <p class="mb-5 text-secondary" style="max-width: 800px; margin: auto;">
      At Nexuscore, we provide top-quality computer parts and repair services, tailored to your needs. Explore our convenient solutions for in-store, online, and home repairs.
    </p>

    <div class="row justify-content-center g-4">
      <div class="col-md-4">
        <div class="card h-100 text-center shadow-sm p-3">
          <h5 class="fw-bold text-orange">Online Service Booking</h5>
          <p>Schedule services anytime with our easy-to-use online booking system.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 text-center shadow-sm p-3">
          <h5 class="fw-bold text-orange">In-Store & Repair Services</h5>
          <p>Get your devices repaired or buy components directly at our store.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 text-center shadow-sm p-3">
          <h5 class="fw-bold text-orange">Door-to-Door Repairs</h5>
          <p>Our technicians come to your home or office for hassle-free repairs.</p>
        </div>
      </div>
    </div>
  </div>
</section>


</section>

<script src="{{ asset('build/app.js') }}"></script>
{% endblock %}
