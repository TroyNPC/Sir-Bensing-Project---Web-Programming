{% extends 'base.html.twig' %}

{% block title %}Nexuscore | Home{% endblock %}

{% block body %}

<link href="https://fonts.googleapis.com/css?family=Montserrat" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
<link rel="stylesheet" href="{{ asset('build/app.css') }}"> 

<style>
  body {
    font-family: 'Montserrat', 'Open Sans', sans-serif !important;
    overflow-x: hidden;
    background: #fff;
  }
  .btn-orange {
    background: #F88F6A;
    color: #fff;
    transition: 0.3s;
  }
  .btn-orange:hover {
    background: #e47654;
    color: #fff;
  }
  .card:hover {
    transform: translateY(-6px);
    transition: 0.3s ease;
  }
</style>

<header class="navbar p-3" style="background: #2e2e2e;">
  <div class="container-fluid flex-wrap justify-content-between align-items-center">

    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center mb-2 mb-lg-0">
      <img src="{{ asset('ICon.png') }}" alt="Logo"
           style="width: 50px; height: 32px; filter: grayscale(1) brightness(0) invert(1);">
    </a>

    <!-- Nav links -->
    <ul class="nav justify-content-center flex-wrap mx-auto">
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_projects') }}">Home</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_products') }}">Products</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_servicebooking_new') }}">Service Booking</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="#">About</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_contact') }}">Contact</a>
      </li>
    </ul>

    <!-- Right Buttons -->
    <div class="d-flex flex-wrap justify-content-center justify-content-lg-end gap-2 mt-3 mt-lg-0">
      <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Login</a>
      <a href="{{ path('app_user_new') }}" class="btn btn-sm text-white" style="background: #F88F6A;">Sign-up</a>
    </div>

  </div>
</header>

<!-- Carousel -->
<section class="mt-0">
  <div id="imageCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner rounded-2 shadow" style="height: 500px;">
      <div class="carousel-item active h-100">
        <img src="{{ asset('Repair1.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.7;">
        <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
          <h1 class="fw-bold text-dark">WELCOME TO NEXUSCORE</h1>
          <p class="fs-4 text-orange">Computer Parts + Repair</p>
        </div>
      </div>
      <div class="carousel-item h-100">
        <img src="{{ asset('Repair2.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.7;">
        <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
          <h1 class="fw-bold text-dark">YOUR TECH SOLUTION</h1>
          <p class="fs-4 text-orange">Fast. Reliable. Affordable.</p>
        </div>
      </div>
      <div class="carousel-item h-100">
        <img src="{{ asset('Repair3.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.7;">
        <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
          <h1 class="fw-bold text-dark">AVAILABLE SERVICE BOOKING!</h1>
          <p class="fs-4 text-orange">Top Quality Services & Advisers</p>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" style="filter: invert(1)"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" style="filter: invert(1)"></span>
    </button>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="text-center py-5">
  <h2 class="fw-bold mb-4 text-dark">Featured Products</h2>
  <div class="container">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
      {% for i in 1..8 %}
      <div class="col">
        <div class="card h-100 shadow-sm">
          <img src="{{ asset('product' ~ (i % 5 + 1) ~ '.jpg') }}" class="card-img-top" style="height: 180px; object-fit: cover;">
          <div class="card-body">
            <h5 class="card-title">Product {{ i }}</h5>
            <p class="card-text">Short description of product {{ i }}.</p>
            <p class="fw-bold text-orange">₱{{ 999 + (i * 100) }}</p>
            <a href="#" class="btn btn-orange" style="background: orange; width: 100px; height: 40px; line-height: 40px; padding: 0; text-align: center;">View</a> 
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Second Section for middle Part (FEATURED PRODUCTS) -->
<container class="section d-flex flex-column justify-content-center align-items-center" 
          style="min-height: 50vh; width: 100%; padding: 0; margin: 0; background: #f5f5f5">
  <div class="py-5 w-100 m-0 p-0">

    <div class="boxes d-flex flex-wrap justify-content-center align-items-center gap-4" 
        style="width: 100%; background: linear-gradient(to right, #2e2e2e, #F88F6A); padding: 2rem 0;">

      <!-- Black container -->
      <div class="container-lg mb-4 mx-3" 
          style="position:relative; background: #2e2e2e; width: auto; max-width: 1100px; min-width: 300px; height: 400px; border-radius: 20px;">
        <div class="row g-3 justify-content-center w-100 m-0">
          <div class="col-12 col-sm-6 col-md-6 col-lg-6 d-flex">
            <div class="big-box card h-100 shadow-sm w-100">
              <img src="{{ asset('gallery1.jpg') }}" class="card-img-top" alt="Gallery 1" 
                  style="height: 150px; object-fit: cover; width: 100%;">
              <div class="card-body">
                <h5 class="card-title">Gallery Item 1</h5>
                <p class="card-text">Description for gallery item 1.</p>
                <a href="#" class="btn text-white" style="background: #F88F6A;">View</a> 
              </div>
            </div>
          </div>

          <div class="col-12 col-sm-6 col-md-6 col-lg-6 d-flex">
            <div class="big-box card h-100 shadow-sm w-100">
              <img src="{{ asset('gallery2.jpg') }}" class="card-img-top" alt="Gallery 2" 
                  style="height: 150px; object-fit: cover; width: 100%;">
              <div class="card-body">
                <h5 class="card-title">Gallery Item 2</h5>
                <p class="card-text">Description for gallery item 2.</p>
                <a href="#" class="btn text-white" style="background: #F88F6A;">View</a> 
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Orange container -->
      <div class="container-lg mb-4 mx-3" 
          style="position:relative; background: #F88F6A; width: auto; max-width: 900px; min-width: 300px; height: 400px; border-radius: 20px;">
        <div class="row g-3 justify-content-center w-100 m-0">
          <div class="col-12 col-sm-6 col-md-6 col-lg-6 d-flex">
            <div class="big-box card h-100 shadow-sm w-100">
              <img src="{{ asset('gallery1.jpg') }}" class="card-img-top" alt="Gallery 1" 
                  style="height: 150px; object-fit: cover; width: 100%;">
              <div class="card-body">
                <h5 class="card-title">Gallery Item 1</h5>
                <p class="card-text">Description for gallery item 1.</p>
                <a href="#" class="btn text-white" style="background: #2e2e2e;">View</a> 
              </div>
            </div>
          </div>

          <div class="col-12 col-sm-6 col-md-6 col-lg-6 d-flex">
            <div class="big-box card h-100 shadow-sm w-100">
              <img src="{{ asset('gallery2.jpg') }}" class="card-img-top" alt="Gallery 2" 
                  style="height: 150px; object-fit: cover; width: 100%;">
              <div class="card-body">
                <h5 class="card-title">Gallery Item 2</h5>
                <p class="card-text">Description for gallery item 2.</p>
                <a href="#" class="btn text-white" style="background: #2e2e2e;">View</a> 
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</container>

<!-- About Section -->
<section class="py-5" style="background: #f5f5f5;">
  <div class="container text-center">
    <h2 class="fw-bold mb-4 text-dark">About Nexuscore</h2>
    <p class="mb-4 text-dark" style="max-width: 800px; margin: auto; line-height: 1.6;">
      Nexuscore is your one-stop solution for all computer needs. We specialize in selling high-quality computer parts and providing reliable repair services. 
      Our mission is to make technology accessible, affordable, and convenient for everyone.
    </p>

    <div class="row justify-content-center g-4 mt-4">
      <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 15px;">
          <div class="card-body">
            <h5 class="card-title fw-bold">Available Service Booking</h5>
            <p class="card-text">Easily book any of our services online for faster and smoother service experience.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 15px;">
          <div class="card-body">
            <h5 class="card-title fw-bold">In-Store & Repair Services</h5>
            <p class="card-text">Purchase computer parts or have your devices repaired directly at Nexuscore.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 15px;">
          <div class="card-body">
            <h5 class="card-title fw-bold">Door-to-Door Repair</h5>
            <p class="card-text">Convenient repair services delivered straight to your home or office.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-white py-4" style="background: #2e2e2e;">
  <div class="container text-center">
    <div class="row">
      <div class="col-md-6 mb-3 mb-md-0">
        <h5 class="fw-bold">Nexuscore</h5>
        <p style="margin: 0;">We build, advise and repair!.</p>
      </div>
      <div class="col-md-6">
        <h6 class="fw-bold">Contact Us</h6>
        <p style="margin: 0;">Email: troygrefalde@nexuscore.com.ph</p>
        <p style="margin: 0;">Phone: +63 123 456 7890</p>
      </div>
    </div>
    <hr style="border-color: rgba(255,255,255,0.2);">
  </div>
</footer>

<script src="{{ asset('build/app.js') }}"></script>
{% endblock %}
