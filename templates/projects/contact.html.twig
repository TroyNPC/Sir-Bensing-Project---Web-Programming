{% extends 'headerfooter.html.twig' %}

{% block title %}Nexuscore | Contact{% endblock %}

{% block body %}

  {# Child templates can inject their own CSS here #}
{% block feature_stylesheets %}
<link rel="stylesheet" href="{{ asset('Arrangestyle/projects/customercontact.css') }}">
{% endblock %}

<!-- Contact Section -->
<section class="contact-section">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold text-dark">Get in Touch</h2>
      <p class="text-muted">We’d love to hear from you. Please fill out the form or reach us via the information below.</p>
    </div>

    <div class="row g-4 align-items-center">
      <!-- Contact Form -->
      <div class="col-lg-7">
        <div class="contact-card">
          <form>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" placeholder="Enter your name">
              </div>
              <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control" placeholder="Enter your email">
              </div>
              <div class="col-12">
                <label class="form-label">Subject</label>
                <input type="text" class="form-control" placeholder="Subject">
              </div>
              <div class="col-12">
                <label class="form-label">Message</label>
                <textarea class="form-control" rows="5" placeholder="Write your message here..."></textarea>
              </div>
              <div class="col-12 text-end">
                <button type="submit" class="btn btn-orange px-4">Send Message</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info + Image -->
      <div class="col-lg-5">
        <div class="contact-card h-100">
          <h5 class="fw-bold mb-3">Contact Information</h5>
          <div class="contact-info mb-3">
            <p><i class="bi bi-envelope-fill"></i> support@nexuscore.com.ph</p>
            <p><i class="bi bi-telephone-fill"></i> +63 123 456 7890</p>
            <p><i class="bi bi-geo-alt-fill"></i> Cebu City, Philippines</p>
          </div>
          <i class="bi bi-person-circle fs-1 text-primary"></i>

        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
