{% extends 'base.html.twig' %}

{% block title %}Nexuscore | Contact{% endblock %}

{% block body %}
<link href="https://fonts.googleapis.com/css?family=Montserrat" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
<link rel="stylesheet" href="{{ asset('build/app.css') }}">

<style>
  body {
    font-family: 'Montserrat', 'Open Sans', sans-serif !important;
    overflow-x: hidden;
    background: #fff;
  }
  .contact-section {
    padding: 60px 0;
    background: #f5f5f5;
  }
  .contact-card {
    background: #fff;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: 0.3s ease;
  }
  .contact-card:hover {
    transform: translateY(-5px);
  }
  .form-control, .form-select {
    border-radius: 8px;
    padding: 12px;
    font-size: 0.95rem;
  }
  .btn-orange {
    background: #F88F6A;
    color: #fff;
    transition: 0.3s;
  }
  .btn-orange:hover {
    background: #e47654;
    color: #fff;
  }
  .contact-info i {
    color: #F88F6A;
    font-size: 1.2rem;
    margin-right: 10px;
  }
</style>

<header class="navbar p-3" style="background: #2e2e2e;">
  <div class="container-fluid flex-wrap justify-content-between align-items-center">

    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center mb-2 mb-lg-0">
      <img src="{{ asset('ICon.png') }}" alt="Logo"
           style="width: 50px; height: 32px; filter: grayscale(1) brightness(0) invert(1);">
    </a>

    <!-- Nav links -->
    <ul class="nav justify-content-center flex-wrap mx-auto">
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_projects') }}">Home</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_products') }}">Products</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_servicebooking_new') }}">Service Booking</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="#">About</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white fs-6 fs-md-5 fs-lg-6" href="{{ path('app_contact') }}">Contact</a>
      </li>
    </ul>

    <!-- Right Buttons -->
    <div class="d-flex flex-wrap justify-content-center justify-content-lg-end gap-2 mt-3 mt-lg-0">
      <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Login</a>
      <a href="{{ path('app_user_new') }}" class="btn btn-sm text-white" style="background: #F88F6A;">Sign-up</a>
    </div>

  </div>
</header

<!-- Contact Section -->
<section class="contact-section">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold text-dark">Get in Touch</h2>
      <p class="text-muted">We’d love to hear from you. Please fill out the form or reach us via the information below.</p>
    </div>

    <div class="row g-4 align-items-center">
      <!-- Contact Form -->
      <div class="col-lg-7">
        <div class="contact-card">
          <form>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" placeholder="Enter your name">
              </div>
              <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control" placeholder="Enter your email">
              </div>
              <div class="col-12">
                <label class="form-label">Subject</label>
                <input type="text" class="form-control" placeholder="Subject">
              </div>
              <div class="col-12">
                <label class="form-label">Message</label>
                <textarea class="form-control" rows="5" placeholder="Write your message here..."></textarea>
              </div>
              <div class="col-12 text-end">
                <button type="submit" class="btn btn-orange px-4">Send Message</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info + Image -->
      <div class="col-lg-5">
        <div class="contact-card h-100">
          <h5 class="fw-bold mb-3">Contact Information</h5>
          <div class="contact-info mb-3">
            <p><i class="bi bi-envelope-fill"></i> support@nexuscore.com.ph</p>
            <p><i class="bi bi-telephone-fill"></i> +63 123 456 7890</p>
            <p><i class="bi bi-geo-alt-fill"></i> Cebu City, Philippines</p>
          </div>
          <img src="{{ asset('contact-illustration.png') }}" alt="Contact" class="img-fluid rounded">
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="bg-dark text-white py-4" style="background: #2e2e2e;">
  <div class="container text-center">
    <div class="row">
      <div class="col-md-6 mb-3 mb-md-0">
        <h5 class="fw-bold">Nexuscore</h5>
        <p style="margin: 0;">We build, advise and repair!</p>
      </div>
      <div class="col-md-6">
        <h6 class="fw-bold">Contact Us</h6>
        <p style="margin: 0;">Email: troygrefalde@nexuscore.com.ph</p>
        <p style="margin: 0;">Phone: +63 123 456 7890</p>
      </div>
    </div>
    <hr style="border-color: rgba(255,255,255,0.2);">
  </div>
</footer>

<script src="{{ asset('build/app.js') }}"></script>
{% endblock %}
