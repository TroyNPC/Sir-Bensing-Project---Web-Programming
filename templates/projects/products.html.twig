{% extends 'headerfooter.html.twig' %}

{% block title %}Nexuscore | Products{% endblock %}

{% block content %}
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  body {
    font-family: 'Montserrat', sans-serif;
    background-color: #f4f4f4;
    margin: 0;
    padding: 0;
  }

  .card-img-top {
  width: 100%;
  height: 200px;                /* Keeps consistent card height */
  object-fit: contain !important; /* Ensures full image fits inside */
  background-color: #f8f9fa;     /* Light background behind transparent images */
  border: 1px solid #ddd;        /* Adds clean border */
  border-radius: 10px;           /* Slight rounding to match card */
  padding: 5px;                  /* Adds spacing inside the frame */
  box-sizing: border-box;        /* Keeps layout consistent */
}
  .hero {
    background: linear-gradient(to right, #ff7e5f, #feb47b);
    color: white;
    text-align: center;
    padding: 50px 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin: 0;
  }

  .hero p {
    font-size: 1.2rem;
    margin: 10px 0;
  }

  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: white;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .filter-bar button,
  .filter-bar select {
    padding: 10px;
    font-size: 1rem;
    border: 1px solid #ddd;
    border-radius: 5px;
    cursor: pointer;
  }

  .filter-bar button.active {
    background-color: #feb47b;
    color: white;
  }

  /* Carousel Wrapper */
  .carousel-wrapper {
    position: relative;
    overflow: hidden;
    margin: 30px auto;
    width: 95%;
  }

  .carousel-inner {
    display: flex;
    gap: 25px;
    transition: transform 0.4s ease;
    padding: 10px 50px; /* Prevent arrow overlap */
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 126, 95, 0.9);
    color: white;
    border: none;
    border-radius: 50%;
    width: 45px;
    height: 45px;
    cursor: pointer;
    font-size: 1.5rem;
    z-index: 10;
    transition: background 0.3s ease;
  }

  .carousel-arrow:hover {
    background: rgba(254, 180, 123, 1);
  }

  .carousel-arrow.left {
    left: 5px;
  }

  .carousel-arrow.right {
    right: 5px;
  }

  /* Product Card */
  .product-card {
    background-color: white;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    flex: 0 0 250px;
    transition: transform 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .product-card .body {
    padding: 15px;
    text-align: center;
  }

  .product-card .body h5 {
    font-size: 1.1rem;
    margin: 10px 0;
  }

  .product-card .body p {
    font-size: 0.95rem;
    color: #666;
    margin: 8px 0;
  }

  .product-card .body .price {
    font-size: 1.1rem;
    color: #ff7e5f;
    font-weight: bold;
    margin: 8px 0;
  }

  .product-card .body .btn-view {
    padding: 8px 16px;
    background-color: #ff7e5f;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .product-card .body .btn-view:hover {
    background-color: #feb47b;
  }

  /* Modal */
  .modal-content {
    border-radius: 10px;
    overflow: hidden;
  }

  .modal-header {
    background-color: #ff7e5f;
    color: white;
  }

  .modal-body img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .product-card {
      flex: 0 0 220px;
    }
  }

  @media (max-width: 992px) {
    .product-card {
      flex: 0 0 200px;
    }
  }

  @media (max-width: 768px) {
    .product-card {
      flex: 0 0 45%;
    }

    .carousel-arrow {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .product-card {
      flex: 0 0 90%;
    }
  }
</style>

<div class="hero">
  <h1>Discover Top PC Components</h1>
  <p>Explore our exclusive deals and find the perfect parts for your build</p>
</div>

<div class="filter-bar">
  <div>
    <button class="btn-category active" onclick="filterCategory('All')">All</button>
    <button class="btn-category" onclick="filterCategory('GPU')">GPU</button>
    <button class="btn-category" onclick="filterCategory('RAM')">RAM</button>
    <button class="btn-category" onclick="filterCategory('Motherboard')">Motherboard</button>
    <button class="btn-category" onclick="filterCategory('Case')">Case</button>
    <button class="btn-category" onclick="filterCategory('Cooling')">Cooling</button>
    <button class="btn-category" onclick="filterCategory('Storage')">Storage</button>
    <button class="btn-category" onclick="filterCategory('Power Supply')">Power Supply</button>
  </div>
  <select id="brandFilter" onchange="filterBrand()">
    <option value="">All Brands</option>
    <option value="Asus">Asus</option>
    <option value="MSI">MSI</option>
    <option value="Gigabyte">Gigabyte</option>
    <option value="Easy PC">Easy PC</option>
    <option value="Corsair">Corsair</option>
    <option value="Cooler Master">Cooler Master</option>
    <option value="EVGA">EVGA</option>
  </select>
</div>

<div class="carousel-wrapper">
  <button class="carousel-arrow left" onclick="scrollCarousel(-1)">&#10094;</button>
  <div class="carousel-inner" id="productGrid">
    {% for product in products %}
      <div class="product-card" data-category="{{ product.category }}" data-brand="{{ product.brand }}">
        <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}">
        <div class="body">
          <h5>{{ product.name }}</h5>
          <p>{{ product.description|length > 60 ? product.description|slice(0,60) ~ '...' : product.description }}</p>
          <div class="price">₱{{ product.price }}</div>
          <button class="btn-view" data-bs-toggle="modal" data-bs-target="#viewModal{{ product.id }}">View</button>
        </div>
      </div>

      <!-- Modal -->
      <div class="modal fade" id="viewModal{{ product.id }}" tabindex="-1" aria-labelledby="viewModalLabel{{ product.id }}" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">{{ product.name }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
              <img src="{{ asset('uploads/products/' ~ product.image) }}" class="img-fluid mb-3" style="max-height:300px;object-fit:contain;">
              <p><strong>Category:</strong> {{ product.category }}</p>
              <p><strong>Brand:</strong> {{ product.brand }}</p>
              <p><strong>Price:</strong> ₱{{ product.price }}</p>
              <p><strong>Description:</strong> {{ product.description }}</p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <button class="carousel-arrow right" onclick="scrollCarousel(1)">&#10095;</button>
</div>

<script>
  let currentCategory = 'All';

  function filterCategory(cat) {
    currentCategory = cat;
    document.querySelectorAll('.btn-category').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    applyFilters();
  }

  function filterBrand() {
    applyFilters();
  }

  function applyFilters() {
    const grid = document.getElementById('productGrid');
    const brandVal = document.getElementById('brandFilter').value;

    grid.querySelectorAll('.product-card').forEach(card => {
      const cat = card.getAttribute('data-category');
      const br = card.getAttribute('data-brand');
      const catMatch = (currentCategory === 'All') || (cat === currentCategory);
      const brandMatch = !brandVal || (br === brandVal);
      card.style.display = (catMatch && brandMatch) ? '' : 'none';
    });
  }

  function scrollCarousel(direction) {
    const grid = document.getElementById('productGrid');
    const cardWidth = grid.querySelector('.product-card')?.offsetWidth || 250;
    grid.scrollBy({ left: direction * (cardWidth + 25) * 3, behavior: 'smooth' });
  }
</script>

{% endblock %}
