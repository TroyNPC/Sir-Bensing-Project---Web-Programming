{% extends 'headerfooter.html.twig' %}

{% block title %}Nexuscore | Products{% endblock %}

{% block body %}
<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --primary-orange: #F88F6A;
    --primary-dark: #2e2e2e;
  }

  /* ===== HERO SECTION ===== */
  .hero {
    background: linear-gradient(to right, #ff7e5f, #feb47b);
    color: white;
    text-align: center;
    padding: 60px 0;
    font-family: 'Montserrat', sans-serif;
  }

  .hero h1 { font-size: 2.7rem; margin: 0; }
  .hero p { font-size: 1.25rem; margin: 10px 0; }

  /* ===== PAGE LAYOUT ===== */
  .products-container {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 30px;
    padding: 50px;
  }

  /* ===== BRANDS DROPDOWN STYLING ===== */
  .sidebar h5 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    color: var(--primary-dark);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sidebar select {
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    border: 2px solid #eee;
    background-color: #fff;
    font-family: 'Open Sans', sans-serif;
    font-size: 1rem;
    color: #444;
    transition: all 0.3s ease;
    cursor: pointer;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.05);
  }

  .sidebar select:hover {
    border-color: var(--primary-orange);
    box-shadow: 0 4px 10px rgba(248, 143, 106, 0.15);
  }

  .sidebar select:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 3px rgba(248, 143, 106, 0.2);
  }

  .btn-category {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 10px 12px;
    margin: 5px 0;
    cursor: pointer;
    font-size: 1rem;
    color: #444;
    border-radius: 6px;
    transition: 0.3s;
  }

  .btn-category:hover, .btn-category.active {
    background-color: var(--primary-orange);
    color: white;
  }

  /* ===== PRODUCT GRID ===== */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }

  .product-card {
    background-color: white;
    border-radius: 14px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .card-img-top {
    width: 100%;
    height: 230px;
    object-fit: contain !important;
    background-color: #f8f9fa;
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 8px;
  }

  h5{
    font-weight: 700;
  }

  .product-card .body{
    padding: 18px;
    text-align: center;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .price {
    font-size: 1.15rem;
    color: var(--primary-orange);
    font-weight: bold;
    margin: 10px 0;
  }

  .btn-order, .btn-view {
    display: inline-block;
    text-align: center;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 16px;
    transition: all 0.3s ease;
    font-family: 'Montserrat', sans-serif;
    text-decoration: none;
    flex: 1;
    max-width: 140px;
  }

  .btn-order {
    background-color: #F88F6A;
    color: white;
    border: none;
  }
  .btn-order:hover { background-color: #e67854; }

  .btn-view {
    background-color: transparent;
    border: 2px solid #F88F6A;
    color: #F88F6A;
  }
  .btn-view:hover {
    background-color: #F88F6A;
    color: white;
  }

  .button-group {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: auto;
  }

  /* ===== MODAL (New Modernized Style) ===== */
  .modal-content {
    border: none;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }

  .modal-header {
    border-bottom: none;
    background: var(--primary-orange);
    color: white;
    padding: 20px 24px;
  }

  .modal-header h5 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 1000;
  }

  .modal-body {
    padding: 25px 30px;
  }

  .modal-body img {
    border-radius: 12px;
    border: 1px solid #eee;
    box-shadow: 0 3px 10px rgba(0,0,0,0.05);
  }

  .modal-body .details h5 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--primary-dark);
  }

  .modal-body .details p {
    margin-bottom: 8px;
    color: #555;
  }

  .modal-body .price-tag {
    font-size: 1.4rem;
    color: var(--primary-orange);
    font-weight: 700;
    margin-top: 10px;
  }

  .modal-footer {
    border-top: none;
    background-color: #fdfdfd;
    padding: 18px 30px;
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }

  .modal-footer .btn-order,
.modal-footer .btn-view,
.modal-footer .btn-secondary {
  min-width: 200px; /* increase button width */
  text-align: center;
  font-weight: 600;
  border-radius: 8px;
}
  .modal-footer .btn-order {
    background-color: var(--primary-orange);
    color: #fff;
    padding: 10px 18px;
    font-weight: 600;
    border-radius: 8px;
  }

  .modal-footer .btn-view {
    border: 2px solid var(--primary-orange);
    color: var(--primary-orange);
    background: white;
    padding: 10px 18px;
  }

  .modal-footer .btn-view:hover {
    background-color: var(--primary-orange);
    color: white;
  }

  @media (max-width: 768px) {
    .modal-body { padding: 20px; }
    .modal-body .row { flex-direction: column; text-align: center; }
  }
.sidebar {
  display: flex;
  flex-direction: column;
}

.pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 20px;
    gap: 8px;
    border-top: 2px solid #eee; /* horizontal line above page buttons */
    padding-top: 15px;
}

.pagination button {
    background: white;
    border: 2px solid var(--primary-orange);
    color: var(--primary-orange);
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
}

.pagination button.active {
    background: var(--primary-orange);
    color: white;
}


</style>

<div class="hero">
  <h1>Discover Top PC Components</h1>
  <p>Explore our exclusive deals and find the perfect parts for your build</p>
</div>

<div class="products-container">
  <div class="sidebar">
    <h5>Categories</h5>
    <button class="btn-category active" onclick="filterCategory('All')">All</button>
    <button class="btn-category" onclick="filterCategory('GPU')">GPU</button>
    <button class="btn-category" onclick="filterCategory('RAM')">RAM</button>
    <button class="btn-category" onclick="filterCategory('Motherboard')">Motherboard</button>
    <button class="btn-category" onclick="filterCategory('Case')">Case</button>
    <button class="btn-category" onclick="filterCategory('Cooling')">Cooling</button>
    <button class="btn-category" onclick="filterCategory('Storage')">Storage</button>
    <button class="btn-category" onclick="filterCategory('Power Supply')">Power Supply</button>

    <hr>
    <h5>Brands</h5>
    <select id="brandFilter" onchange="filterBrand()">
      <option value="">All Brands</option>
      <option value="Asus">Asus</option>
      <option value="MSI">MSI</option>
      <option value="Gigabyte">Gigabyte</option>
      <option value="Corsair">Corsair</option>
      <option value="Cooler Master">Cooler Master</option>
      <option value="EVGA">EVGA</option>
    </select>

  <!-- Pagination here -->
  <div class="pagination" id="pagination"></div>
  <div style="margin-top: 10px; text-align: center;">
      <select id="pageSelect" onchange="goToPage(this.value)"></select>
  </div>

  </div>

  <div class="product-grid" id="productGrid">
    {% for product in products %}
      <div class="product-card" data-category="{{ product.category }}" data-brand="{{ product.brand }}">
        {% if product.image %}
          <img src="{{ asset('uploads/products/' ~ product.image) }}" class="card-img-top" alt="{{ product.name }}">
        {% else %}
          <div class="d-flex align-items-center justify-content-center bg-light card-img-top">
            <span>No Image</span>
          </div>
        {% endif %}
        <div class="body">
          <h5>{{ product.name }}</h5>
          <p>{{ product.description|length > 60 ? product.description|slice(0,60) ~ '...' : product.description }}</p>
          <div class="price">₱{{ product.price }}</div>
          <div class="d-flex justify-content-between">
            <button class="btn-order" data-bs-toggle="modal" data-bs-target="#viewModal{{ product.id }}">Order</button>
            <a href="{{ path('chosen_product', {'id': product.id}) }}" class="btn-view">View</a>
          </div>
        </div>
      </div>

      <!-- Redesigned Modal -->
      <div class="modal fade" id="viewModal{{ product.id }}" tabindex="-1" aria-labelledby="viewModalLabel{{ product.id }}" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">{{ product.name }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <div class="row align-items-center g-4">
                <div class="col-md-5 text-center">
                  {% if product.image %}
                    <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" class="img-fluid">
                  {% else %}
                    <div class="d-flex align-items-center justify-content-center bg-light rounded-3 shadow-sm" style="height:200px;">
                      <span>No Image</span>
                    </div>
                  {% endif %}
                </div>
                <div class="col-md-7 details">
                  <h5>{{ product.name }}</h5>
                  <p><strong>Brand:</strong> {{ product.brand }}</p>
                  <p><strong>Category:</strong> {{ product.category }}</p>
                  <p><strong>Description:</strong> {{ product.description }}</p>
                  <div class="price-tag">₱{{ product.price }}</div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <a href="#" class="btn-order">Order Now</a>
              <a href="{{ path('chosen_product', {'id': product.id}) }}" class="btn-view">View More Details</a>
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

</div>

<script>
  let currentCategory = 'All';
  const productsPerPage = 10;
  let currentPage = 1;

  function filterCategory(cat) {
    currentCategory = cat;
    document.querySelectorAll('.btn-category').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    currentPage = 1;
    applyFilters();
  }

  function filterBrand() { 
    currentPage = 1;
    applyFilters(); 
  }

  function applyFilters() {
    const brandVal = document.getElementById('brandFilter').value;
    const allCards = Array.from(document.querySelectorAll('.product-card'));
    let filtered = allCards.filter(card => {
      const cat = card.getAttribute('data-category');
      const br = card.getAttribute('data-brand');
      const catMatch = (currentCategory === 'All') || (cat === currentCategory);
      const brandMatch = !brandVal || (br === brandVal);
      return catMatch && brandMatch;
    });

    // Hide all first
    allCards.forEach(c => c.style.display = 'none');

    // Pagination
    const totalPages = Math.ceil(filtered.length / productsPerPage);
    const start = (currentPage - 1) * productsPerPage;
    const end = start + productsPerPage;
    filtered.slice(start, end).forEach(c => c.style.display = '');

    renderPagination(totalPages);
  }
function renderPagination(totalPages) {
    const container = document.getElementById('pagination');
    container.innerHTML = '';

    // Numbered buttons (arrows + sliding window)
    const maxVisible = 3; // max visible page buttons at a time
    let startPage = Math.max(1, currentPage - 1);
    let endPage = Math.min(totalPages, startPage + maxVisible - 1);

    // Adjust if at end
    if(endPage - startPage + 1 < maxVisible){
        startPage = Math.max(1, endPage - maxVisible + 1);
    }

    if(currentPage > 1){
        const prevBtn = document.createElement('button');
        prevBtn.innerHTML = '&laquo;';
        prevBtn.addEventListener('click', () => {
            currentPage--;
            applyFilters();
        });
        container.appendChild(prevBtn);
    }

    for(let i=startPage; i<=endPage; i++){
        const btn = document.createElement('button');
        btn.innerText = i;
        btn.classList.toggle('active', i === currentPage);
        btn.addEventListener('click', () => {
            currentPage = i;
            applyFilters();
        });
        container.appendChild(btn);
    }

    if(currentPage < totalPages){
        const nextBtn = document.createElement('button');
        nextBtn.innerHTML = '&raquo;';
        nextBtn.addEventListener('click', () => {
            currentPage++;
            applyFilters();
        });
        container.appendChild(nextBtn);
    }

    // Update dropdown
    const pageSelect = document.getElementById('pageSelect');
    if(totalPages <= 1){
        pageSelect.style.display = 'none'; // hide if only 1 page
    } else {
        pageSelect.style.display = 'block';
        pageSelect.innerHTML = '';
        for(let i=1; i<=totalPages; i++){
            const option = document.createElement('option');
            option.value = i;
            option.innerText = 'Page ' + i;
            if(i === currentPage) option.selected = true;
            pageSelect.appendChild(option);
        }
    }
}


// Dropdown page jump
function goToPage(page) {
    currentPage = parseInt(page);
    applyFilters();
}



  // Initial load
  applyFilters();
</script>
{% endblock %}
