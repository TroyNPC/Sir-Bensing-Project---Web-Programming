{% extends 'layout.html.twig' %}


{% block title %}Walk-in Orders{% endblock %}


{% block feature_stylesheet %}
<link rel="stylesheet" href="{{ asset('Arrangestyle/walkinorders/walkinorders.css') }}">
{% endblock %}


{% block content %}
<div class="container-fluid py-5">


    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 px-3">
        <h3 class="fw-bold mb-0" style="color:#2e2e2e;">🧾 Walk-in Orders</h3>


        <a href="{{ path('app_walkin_orders_new') }}"
           class="btn btn-sm fw-semibold"
           style="background-color:#F88F6A; color:white; border-radius:6px; padding:6px 12px;"
           data-turbo="false"
           >
            Add Walk-in Order
        </a>
    </div>


    {# FLASHES #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"
                        data-turbo="false">
                </button>
            </div>
        {% endfor %}
    {% endfor %}


    <div class="card border-0 shadow-sm rounded-4 mx-1">
        <div class="card-body p-0">
            <div class="table-responsive table-scroll">


                <table id="walkinOrdersTable"
                       class="table table-hover table-bordered align-middle mb-0"
                       style="min-width:900px;">


                    <thead style="background-color:#F88F6A; color:white;">
                        <tr class="text-center">
                            <th width="5%">ID</th>
                            <th width="15%">Buyer</th>
                            <th width="12%">Contact</th>
                            <th width="14%">Payment Method</th>
                            <th width="8%">Status</th>
                            <th width="20%">Product</th>
                            <th width="6%">Quantity</th>
                            <th width="12%">Purchase Date</th>
                            <th width="8%">Actions</th>
                        </tr>
                    </thead>


                    <tbody>
                        {% if walkin_orders|length > 0 %}
                            {% for order in walkin_orders %}
                                <tr class="text-center">
                                    <td>{{ loop.index }}</td>
                                    <td>{{ order.buyerName }}</td>
                                    <td>{{ order.contact }}</td>


                                    <td>
                                        {% if order.paymentMethod == 'cash' %}
                                            Cash
                                        {% elseif order.paymentMethod == 'credit_card' %}
                                            Credit Card
                                        {% elseif order.paymentMethod == 'debit_card' %}
                                            Debit Card
                                        {% elseif order.paymentMethod == 'gcash' %}
                                            GCash
                                        {% elseif order.paymentMethod == 'bank_transfer' %}
                                            Bank Transfer
                                        {% else %}
                                            {{ order.paymentMethod }}
                                        {% endif %}
                                    </td>


                                    <td>
                                        {% if order.paymentStatus == 'paid' %}
                                            <span class="badge bg-success">Paid</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark">Unpaid</span>
                                        {% endif %}
                                    </td>


                                    <td>{{ order.product ? order.product.name : '—' }}</td>


                                    <td>{{ order.quantity }}</td>


                                    <td>
                                        {{ order.purchaseDate ? order.purchaseDate|date('Y-m-d H:i') : '—' }}
                                    </td>


                                    <td>
                                        <div class="d-flex justify-content-center gap-1 flex-nowrap">


                                            {# 🔍 VIEW → OPEN MODAL, NOT PAGE #}
                                            <button type="button"
                                                    class="btn btn-sm btn-secondary fw-semibold"
                                                    style="border-radius:6px; padding:3px 8px;"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#viewWalkinOrderModal{{ order.id }}">
                                                View
                                            </button>


                                            {# ✏️ EDIT (unchanged – still goes to page) #}
                                            <a href="{{ path('app_walkin_orders_edit', {'id': order.id}) }}"
                                               class="btn btn-sm fw-semibold"
                                               style="background-color:#2e2e2e; color:white; border-radius:6px; padding:3px 8px;"
                                               data-turbo="false"
                                               >
                                                Edit
                                            </a>


                                            {# 🗑 DELETE (unchanged) #}
                                            <form method="post"
                                                  action="{{ path('app_walkin_orders_delete', {'id': order.id}) }}"
                                                  onsubmit="return confirm('Are you sure you want to delete this order?');"
                                                  style="display:inline-block;"
                                                  data-turbo="false">


                                                <input type="hidden"
                                                       name="_token"
                                                       value="{{ csrf_token('delete' ~ order.id) }}">


                                                <button type="submit"
                                                        class="btn btn-sm fw-semibold"
                                                        style="background-color:#dc3545; color:white; border-radius:6px; padding:3px 8px;">
                                                    Delete
                                                </button>
                                            </form>


                                        </div>
                                    </td>
                                </tr>


                                {# 🔽 VIEW MODAL FOR THIS ORDER (uses same layout as show.html.twig) #}
                                <div class="modal fade" id="viewWalkinOrderModal{{ order.id }}" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content border-0 rounded-4 shadow-lg">


                                            <div class="modal-header" style="background-color:#2e2e2e; color:white;">
                                                <h5 class="modal-title">
                                                    🧾 Walk-in Order
                                                </h5>
                                                <button type="button"
                                                        class="btn-close btn-close-white"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                            </div>


                                            <div class="modal-body p-4">
                                                <dl class="row mb-0">
                                                    <dt class="col-md-3 fw-semibold">Buyer Name</dt>
                                                    <dd class="col-md-9">{{ order.buyerName }}</dd>


                                                    <dt class="col-md-3 fw-semibold">Contact</dt>
                                                    <dd class="col-md-9">{{ order.contact }}</dd>


                                                    <dt class="col-md-3 fw-semibold">Payment Method</dt>
                                                    <dd class="col-md-9">
                                                        {% set pm = order.paymentMethod %}
                                                        {% if pm == 'cash' %}
                                                            Cash
                                                        {% elseif pm == 'credit_card' %}
                                                            Credit Card
                                                        {% elseif pm == 'debit_card' %}
                                                            Debit Card
                                                        {% elseif pm == 'gcash' %}
                                                            GCash
                                                        {% elseif pm == 'bank_transfer' %}
                                                            Bank Transfer
                                                        {% else %}
                                                            {{ pm }}
                                                        {% endif %}
                                                    </dd>


                                                    <dt class="col-md-3 fw-semibold">Payment Status</dt>
                                                    <dd class="col-md-9">
                                                        {% if order.paymentStatus == 'paid' %}
                                                            <span class="badge bg-success">Paid</span>
                                                        {% else %}
                                                            <span class="badge bg-warning text-dark">Unpaid</span>
                                                        {% endif %}
                                                    </dd>


                                                    <dt class="col-md-3 fw-semibold">Product</dt>
                                                    <dd class="col-md-9">
                                                        {{ order.product ? order.product.name : '—' }}
                                                    </dd>


                                                    <dt class="col-md-3 fw-semibold">Quantity</dt>
                                                    <dd class="col-md-9">{{ order.quantity }}</dd>


                                                    <dt class="col-md-3 fw-semibold">Purchase Date</dt>
                                                    <dd class="col-md-9">
                                                        {{ order.purchaseDate ? order.purchaseDate|date('Y-m-d H:i') : '—' }}
                                                    </dd>


                                                    <dt class="col-md-3 fw-semibold">Warranty</dt>
                                                    <dd class="col-md-9">
                                                        <pre class="mb-0" style="white-space:pre-wrap; font-family:inherit;">
{{ order.warrantyText }}
                                                        </pre>
                                                    </dd>
                                                </dl>
                                            </div>


                                            <div class="modal-footer d-flex justify-content-end gap-2">
                                                <button type="button"
                                                        class="btn btn-secondary btn-sm"
                                                        data-bs-dismiss="modal">
                                                    Close
                                                </button>
                                            </div>


                                        </div>
                                    </div>
                                </div>
                                {# 🔼 END VIEW MODAL #}


                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    No walk-in orders found
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>


            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block feature_javascripts %}
{{ encore_entry_script_tags('walkinorder') }}
{% endblock %}






