{% extends 'adminlayout.html.twig' %}

{% block title %}Servicebooking Index{% endblock %}

{% block feature_stylesheets %}
    <link rel="stylesheet" href="{{ asset('Arrangestyle/servicebooking/servicebooking.css') }}">
{% endblock %}

{% block feature_javascripts %}
    {{ encore_entry_script_tags('booking') }}
{% endblock %}





{% block content %}
<div class="container-fluid py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 px-3">
        <h3 class="fw-bold mb-0" style="color:#2e2e2e;">📋 Service Booking List</h3>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4 mx-1">
        <div class="card-body p-0">
            <div class="table-responsive table-scroll">
                <table id="servicebookingTable" class="table table-hover table-bordered align-middle mb-0" style="min-width:1400px;">
                    <thead style="background-color:#F88F6A; color:white;">
                        <tr class="text-center">
                            <th class="fw-bold">ID</th>
                            <th class="fw-bold">Customer Name</th>
                            <th class="fw-bold">Service Type</th>
                            <th class="fw-bold">Adviser Category</th>
                            <th class="fw-bold">Preferred Date</th>
                            <th class="fw-bold">Notes</th>
                            <th class="fw-bold">Created At</th>
                            <th class="fw-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for servicebooking in servicebookings %}
                        <tr>
                            <td class="text-center">{{ servicebooking.id }}</td>
                            <td class="text-center">{{ servicebooking.customername }}</td>
                            <td class="text-center">{{ servicebooking.serviceType }}</td>
                            <td class="text-center">{{ servicebooking.advisercategory }}</td>
                            <td class="text-center">
                                {{ servicebooking.preferredDate ? servicebooking.preferredDate|date('Y-m-d H:i:s') : '' }}
                            </td>
                            <td class="text-center">{{ servicebooking.notes }}</td>
                            <td class="text-center">
                                {{ servicebooking.getCreatedAt() ? servicebooking.getCreatedAt()|date('Y-m-d H:i:s') : '' }}
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                    <button type="button"
                                            class="btn btn-sm fw-semibold"
                                            style="background-color:#F88F6A; color:white; border-radius:6px;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#showModal{{ servicebooking.id }}">
                                        Show
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm fw-semibold"
                                            style="background-color:#2e2e2e; color:white; border-radius:6px;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal{{ servicebooking.id }}">
                                        Edit
                                    </button>

                                    {{ include('servicebooking/_delete_form.html.twig', { servicebooking : servicebooking }) }}
                                </div>
                            </td>
                        </tr>

                        <!-- SHOW MODAL -->
                        <div class="modal fade" id="showModal{{ servicebooking.id }}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content border-0 rounded-4 shadow-lg">
                                    <div class="modal-header" style="background-color:#F88F6A; color:white;">
                                        <h5 class="modal-title fw-semibold">Booking #{{ servicebooking.id }}</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <ul class="list-unstyled mb-3">
                                            <li><strong class="text-secondary">Service Type:</strong> {{ servicebooking.serviceType }}</li>
                                            <li><strong class="text-secondary">Adviser Category:</strong> {{ servicebooking.advisercategory }}</li>
                                            <li><strong class="text-secondary">Preferred Date:</strong> {{ servicebooking.preferredDate ? servicebooking.preferredDate|date('Y-m-d H:i:s') : 'N/A' }}</li>
                                            <li><strong class="text-secondary">Notes:</strong> {{ servicebooking.notes ?? 'No notes' }}</li>
                                            <li><strong class="text-secondary">Created At:</strong> {{ servicebooking.getCreatedAt() ? servicebooking.getCreatedAt()|date('Y-m-d H:i:s') : 'N/A' }}</li>
                                            <li><strong class="text-secondary">Customer Name:</strong> {{ servicebooking.customerName }}</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- EDIT MODAL -->
                        <div class="modal fade" id="editModal{{ servicebooking.id }}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content border-0 rounded-4 shadow-lg">
                                    <div class="modal-header" style="background-color:#2e2e2e; color:white;">
                                        <h5 class="modal-title fw-semibold">Edit Booking #{{ servicebooking.id }}</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4" id="editModalBody{{ servicebooking.id }}">
                                        <div class="text-center text-muted py-3">
                                            <div class="spinner-border text-dark" role="status"></div>
                                            <p class="mt-2 mb-0 small">Loading form...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {% else %}
                        <tr>
                            {# 8 columns in thead → colspan 8 here #}
                            <td colspan="8" class="text-center text-muted py-4">No records found</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}



