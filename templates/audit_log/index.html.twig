{% extends 'adminlayout.html.twig' %}


{% block title %}Audit Logs{% endblock %}


{% block feature_stylesheets %}
    <link rel="stylesheet" href="/Arrangestyle/pcproducts/adminpcproduct.css">
{% endblock %}


{% block content %}
<div class="container-fluid py-5">


    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 px-3">
        <h3 class="fw-bold mb-0" style="color:#2e2e2e;">📜 Audit Logs</h3>


        <!-- ✅ Delete History button -->
        <form method="post"
              action="{{ path('app_audit_log_clear') }}"
              data-turbo="false"
              onsubmit="return confirm('Are you sure you want to delete all audit history?');">
            <input type="hidden" name="_token" value="{{ csrf_token('clear_audit_log') }}">
            <button type="submit"
                    class="btn btn-sm btn-danger px-3 py-2 shadow-sm"
                    style="border-radius:8px;"
                    data-turbo = "false"
                    >
                <i class="bi bi-trash3 me-1"></i> Delete History
            </button>
        </form>
    </div>


    <div class="card border-0 shadow-sm rounded-4 mx-1">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="auditLogTable"
                       class="table table-striped table-bordered w-100"
                       style="min-width: 1100px;">
                    <thead style="background-color:#F88F6A; color:white;">
                        <tr class="text-center">
                            <th>ID</th>
                            <th>Entity &amp; Action</th>
                            <th>Entity Record</th>
                            <th>Old Data</th>
                            <th>New Data</th>
                            <th>Changed By</th>
                            <th>Changed At</th>
                        </tr>
                    </thead>


                    <tbody>
                    {% for log in logs %}
                        {# Remove App\Entity\ and keep the rest #}
                        {% set fullName = log.entityName %}
                        {% set shortName = fullName ? fullName|replace({'App\\Entity\\':''}) : fullName %}


                        <tr>
                            <!-- ID -->
                            <td class="text-center">{{ log.id }}</td>


                            <!-- Entity & Action -->
                            <td class="text-center">
                                <div class="fw-semibold">{{ shortName }}</div>
                                <div class="mt-1">
                                    <span class="badge rounded-pill px-3 py-1"
                                          style="background-color:#2e2e2e; color:white;">
                                        {{ log.actionType.name }}
                                    </span>
                                </div>
                            </td>


                            <!-- Entity Record (Pcproducts ID: 1 / Servicebooking ID: 2 / etc.) -->
                            <td class="text-center">
                                {% if shortName %}
                                    {{ shortName }} ID: {{ log.entityId }}
                                {% else %}
                                    ID: {{ log.entityId }}
                                {% endif %}
                            </td>


                            <!-- Old Data -->
                            <td style="max-width: 320px;">
                                {% set old = log.oldData ?? {} %}


                                {% if old is iterable and old|length %}
                                    <div class="small text-start">
                                        {# Text fields first (everything except image) #}
                                        {% for key, value in old %}
                                            {% if key != 'image' %}
                                                {% set label = key|replace({'_':' '})|title %}
                                                <div class="mb-1">
                                                    <strong>{{ label }}:</strong>
                                                    {% if value is iterable %}
                                                        {{ value|join(', ') }}
                                                    {% else %}
                                                        {{ value }}
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}


                                        {# Image (if present) always below text #}
                                        {% if 'image' in old|keys and old.image %}
                                            <div class="mt-2 text-center">
                                                <img src="{{ asset('uploads/products/' ~ old.image) }}"
                                                     alt="Old image"
                                                     class="rounded border"
                                                     style="max-height:70px; object-fit:contain; background:#f8f8f8; padding:3px;">
                                            </div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>


                            <!-- New Data -->
                            <td style="max-width: 320px;">
                                {% set new = log.newData ?? {} %}


                                {% if new is iterable and new|length %}
                                    <div class="small text-start">
                                        {# Text fields first (everything except image) #}
                                        {% for key, value in new %}
                                            {% if key != 'image' %}
                                                {% set label = key|replace({'_':' '})|title %}
                                                <div class="mb-1">
                                                    <strong>{{ label }}:</strong>
                                                    {% if value is iterable %}
                                                        {{ value|join(', ') }}
                                                    {% else %}
                                                        {{ value }}
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}


                                        {# Image (if present) always below text #}
                                        {% if 'image' in new|keys and new.image %}
                                            <div class="mt-2 text-center">
                                                <img src="{{ asset('uploads/products/' ~ new.image) }}"
                                                     alt="New image"
                                                     class="rounded border"
                                                     style="max-height:70px; object-fit:contain; background:#f8f8f8; padding:3px;">
                                            </div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>


                            <!-- Changed By (user id + username) -->
                            <td class="text-center small">
                                {% set uid = log.changedBy %}
                                {% if uid %}
                                    {% if usersById[uid] is defined %}
                                        {{ usersById[uid].username }}<br>
                                        <span class="text-muted">ID: {{ uid }}</span>
                                    {% else %}
                                        <span class="text-muted">User ID: {{ uid }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted">System / Guest</span>
                                {% endif %}
                            </td>


                            <!-- Changed At (date only) -->
                            <td class="text-center small">
                                {{ log.changedAt ? log.changedAt|date('Y-m-d') : '—' }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>


                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block feature_javascripts %}
    {{ encore_entry_script_tags('auditlog') }}
{% endblock %}





