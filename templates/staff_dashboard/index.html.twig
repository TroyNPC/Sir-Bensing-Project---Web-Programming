{% extends 'layout.html.twig' %}

{% block title %}Staff Dashboard{% endblock %}

{% block content %}
<div class="container-fluid">
  <h3 class="mb-4">Staff Dashboard</h3>

  <div class="row g-4">

    <!-- Total Orders -->
    <div class="col-md-4">
      <div class="card shadow border-0"
           style="background: linear-gradient(135deg, #6a11cb, #2575fc); color: white;">
        <div class="card-body">
          <h5>Total Orders</h5>
          <h2>{{ totalOrders }}</h2>
          <p>Orders you created</p>
        </div>
      </div>
    </div>

    <!-- Pending Orders -->
    <div class="col-md-4">
      <div class="card shadow border-0"
           style="background: linear-gradient(135deg, #ff9a44, #ff6a00); color: white;">
        <div class="card-body">
          <h5>Pending Orders</h5>
          <h2>{{ unpaidOrders }}</h2>
          <p>Unpaid orders</p>
        </div>
      </div>
    </div>

    <!-- Completed Orders -->
    <div class="col-md-4">
      <div class="card shadow border-0"
           style="background: linear-gradient(135deg, #43e97b, #38f9d7); color: white;">
        <div class="card-body">
          <h5>Completed Orders</h5>
          <h2>{{ paidOrders }}</h2>
          <p>Paid orders</p>
        </div>
      </div>
    </div>

    <!-- Total Products -->
    <div class="col-md-4">
      <div class="card shadow border-0"
           style="background: linear-gradient(135deg, #56ccf2, #2f80ed); color: white;">
        <div class="card-body">
          <h5>Total Products</h5>
          <h2>{{ productCount }}</h2>
          <p>Available in inventory</p>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
.card {
  border-radius: 1rem;
  transition: transform 0.3s;
}
.card:hover {
  transform: translateY(-5px);
}
</style>
{% endblock %}
