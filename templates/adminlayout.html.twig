{% extends 'base.html.twig' %}

{% block meta %}
    {{ parent() }}
    <meta name="turbo-visit-control" content="reload">
{% endblock %}

{% block body %}

<div class="admin-layout">
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo">
      <img src="{{ asset('Icon.png') }}" alt="Logo"
           style="width: 50px; height: 40px; filter: grayscale(1) brightness(0) invert(1);">
      <h4 style="color: #F88F6A;">NexusCore</h4>
    </div>

    <ul class="nav flex-column">
      <li class="nav-item">
        <a href="{{ path('app_admindashboard') }}"
           class="nav-link {% if app.request.get('_route') == 'app_admindashboard' %}active{% endif %}">
           <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </a>
      </li>

      <!-- Products -->
      <li class="nav-item">
        <button class="nav-link d-flex justify-content-between align-items-center w-100 border-0 bg-transparent"
                type="button" data-bs-toggle="collapse" data-bs-target="#productsMenu"
                aria-expanded="false" aria-controls="productsMenu">
          <span><i class="bi bi-box-seam me-2"></i> Products</span>
        </button>
        <div class="collapse {% if 'pcproducts' in app.request.get('_route') %}show{% endif %}" id="productsMenu">

          <a href="{{ path('app_pcproducts_index') }}"
             class="nav-link {% if app.request.get('_route') == 'app_pcproducts_index' %}active{% endif %}">
            <i class="bi bi-list-ul me-2"></i> Product List
          </a>
          <a href="{{ path('app_stocks_index')}}"
             class="nav-link {% if app.request.get('_route') == 'app_stocks_index' %}active{% endif %}">
             <i class="bi bi-box-seam me-2"></i> Stocks
          </a>
        </div>
      </li>

      <!-- Service Booking -->
      <li class="nav-item">
        <a href="{{ path('app_servicebooking_index') }}"
           class="nav-link {% if app.request.get('_route') == 'app_servicebooking_index' %}active{% endif %}">
           <i class="bi bi-calendar-check me-2"></i> Service Booking
        </a>
      </li>

      <!-- Users -->
      <li class="nav-item">
        <a href="{{ path('app_users') }}"
           class="nav-link {% if app.request.get('_route') == 'app_users' %}active{% endif %}">
           <i class="bi bi-person-check me-2"></i> Users
        </a>
      </li>

      <!-- Audit Logs -->
      <li class="nav-item">
      <a href="{{ path('app_audit_log_index') }}"
      class="nav-link {% if app.request.get('_route') == 'app_audit_log_index' %}active{% endif %}">
      <i class="bi bi-clock-history me-2"></i> Audit Logs
      </a>
      </li>

    </ul>
  </div>

  <!-- Header -->
  <div class="admin-header d-flex align-items-center justify-content-between px-4 py-2" id="adminHeader">
    <div class="d-flex align-items-center">
      <button id="toggleSidebar" class="btn btn-link text-white me-3 fs-4">
        <i class="bi bi-list"></i>
      </button>
      <h5 class="mb-0 fw-bold" style="color: var(--accent);">Welcome {{ app.user.username }}!</h5>
    </div>

<div class="d-flex align-items-center gap-3">
    <span class="fw-bold" style="color: var(--accent);">
        {{ app.user.username }}
    </span>

    <a href="{{ path('app_logout') }}" class="btn btn-sm btn-light fw-bold">
        Logout
    </a>
</div>

  </div>

  <!-- Main Admin Content -->
  <div class="main-content" id="mainContent">
    {% block content %}{% endblock %}
  </div>
</div>

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('adminlayout') }}

<script>
    if (!window.adminLayoutInit) {
        window.adminLayoutInit = true;
        console.log("✅ adminlayout.js loaded");
    }

    function initSidebar() {
        const sidebar     = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const header      = document.getElementById('adminHeader');
        const toggleBtn   = document.getElementById('toggleSidebar');

        if (!sidebar || !mainContent || !header || !toggleBtn) return;

        console.log("✅ initSidebar running");

        const collapsed = localStorage.getItem('sidebarCollapsed') === 'true';

        sidebar.classList.toggle('collapsed', collapsed);
        mainContent.classList.toggle('expanded', collapsed);
        header.classList.toggle('shifted', collapsed);

        if (!toggleBtn.dataset.bound) {
            toggleBtn.dataset.bound = "true";

            toggleBtn.addEventListener('click', () => {
                const isCollapsed = sidebar.classList.toggle('collapsed');

                mainContent.classList.toggle('expanded', isCollapsed);
                header.classList.toggle('shifted', isCollapsed);

                localStorage.setItem('sidebarCollapsed', isCollapsed);
            });
        }

        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
            if (button.dataset.bound) return;
            button.dataset.bound = "true";

            const icon   = button.querySelector('.toggle-icon');
            const target = document.querySelector(button.dataset.bsTarget);

            if (!target) return;

            const menuId   = target.id;
            const wasOpen  = localStorage.getItem(menuId) === 'true';

            target.classList.toggle('show', wasOpen);

            if (icon) {
                icon.style.transform = wasOpen ? 'rotate(180deg)' : 'rotate(0deg)';
            }

            target.addEventListener('show.bs.collapse', () => {
                localStorage.setItem(menuId, 'true');
                if (icon) icon.style.transform = 'rotate(180deg)';
            });

            target.addEventListener('hide.bs.collapse', () => {
                localStorage.setItem(menuId, 'false');
                if (icon) icon.style.transform = 'rotate(0deg)';
            });
        });
    }

    function initForceReloadLinks() {
        const links = document.querySelectorAll(
            '.sidebar a.nav-link[href]:not([href^="#"]), a.nav-link[href]:not([href^="#"])'
        );

        links.forEach(link => {
            if (link.dataset.forceReloadBound) return;
            link.dataset.forceReloadBound = "true";

            link.addEventListener('click', function (e) {
                const href = this.getAttribute('href');

                if (
                    href &&
                    !href.startsWith('http') &&
                    !href.startsWith('#') &&
                    !href.startsWith('javascript')
                ) {
                    e.preventDefault();
                    window.location.href = href;
                }
            });
        });
    }

    function initAdminLayout() {
        initSidebar();
        initForceReloadLinks();
    }

    document.addEventListener('DOMContentLoaded', initAdminLayout);
    document.addEventListener('turbo:load', initAdminLayout);
</script>

{% block feature_javascripts %}
{% endblock %}
{% endblock %}

{% endblock %}



