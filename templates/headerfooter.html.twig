<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    
    <!-- Load Bootstrap first -->
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    
    <!-- Then your custom styles -->
    <link rel="stylesheet" href="{{ asset('Arrangestyle/customerheaderfooter.css') }}?v=1.1">
    
    <!-- Then other styles -->
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    <link href="https://fonts.googleapis.com/css?family=Montserrat" rel="stylesheet">

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}

        {# Child templates can inject their own CSS here #}
    {% block feature_stylesheets %}{% endblock %}
    {% endblock %}

  </head>

  <body style="overflow:auto">
    <!-- Flash Modal -->
    <div class="modal fade" id="flashModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header bg-success text-white">
            <h5 class="modal-title">Success</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="flashModalBody">
            <!-- Message will be injected here -->
          </div>
        </div>
      </div>
    </div>

    <!-- ===== HEADER ===== -->
    <header class="navbar p-3">
      <div class="container-fluid flex-wrap justify-content-between align-items-center">

        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center mb-2 mb-lg-0" href="{{ path('app_projects') }}">
          <img src="{{ asset('Icon.png') }}" alt="Logo">
        </a>

        <!-- Nav links -->
        <ul class="nav justify-content-center flex-wrap mx-auto">
          <li class="nav-item">
            <a id="nav-home" class="nav-link fs-6 {% if app.request.get('_route') == 'app_projects' %}active{% endif %}" href="{{ path('app_projects') }}">Home</a>
          </li>
          <li class="nav-item">
            <a id="nav-products" class="nav-link fs-6 {% if 'products' in app.request.get('_route') %}active{% endif %}" href="{{ path('app_products') }}">Products</a>
          </li>
          <li class="nav-item">
            <a id="nav-services" class="nav-link fs-6 {% if 'servicebooking' in app.request.get('_route') %}active{% endif %}" href="{{ path('app_servicebooking_new') }}">Service Booking</a>
          </li>
          <li class="nav-item">
            <a id="nav-about" class="nav-link fs-6 {% if 'about' in app.request.get('_route') %}active{% endif %}" href="{{ path('app_about')}}">About</a>
          </li>
          <li class="nav-item">
            <a id="nav-contact" class="nav-link fs-6 {% if 'contact' in app.request.get('_route') %}active{% endif %}" href="{{ path('app_contact')}}">Contact</a>
          </li>
        </ul>

        <!-- RIGHT SIDE AUTH AREA -->
        <div class="d-flex align-items-center gap-3">
          {% if app.user %}
            <!-- Welcome Text -->
            <span class="fw-semibold" style="color: #F88F6A;">Welcome, {{ app.user.username }}</span>

            <!-- Logout Button -->
            <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-danger">
              Logout
            </a>
          {% else %}
          <!-- Login + Register Buttons -->
          <a href="{{ path('app_login') }}" class="btn-login">Login</a>
          <a href="{{ path('app_register') }}" class="btn-register">Register</a>
          {% endif %}
        </div>

      </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main style="min-height: 75vh; padding: 2rem;">
      {% block body %}{% endblock %}
    </main>

    <!-- ===== FOOTER ===== -->
    <footer>
      <div class="social-links">
        <a href="#"><i class="bi bi-facebook"></i></a>
        <a href="#"><i class="bi bi-instagram"></i></a>
        <a href="#"><i class="bi bi-twitter-x"></i></a>
      </div>
      <p>© {{ "now"|date("Y") }} NexusCore. All Rights Reserved.</p>
    </footer>

    <!-- Load JavaScript in correct order -->
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('build/app.js') }}"></script>

    {% block javascripts %}
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          {% for label, messages in app.flashes %}
            {% for message in messages %}
              const modalBody = document.getElementById('flashModalBody');
              if (modalBody) {
                modalBody.textContent = "{{ message|e('js') }}";
                const flashModal = new bootstrap.Modal(document.getElementById('flashModal'));
                flashModal.show();
              }
            {% endfor %}
          {% endfor %}
        });
      </script>
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </body>
</html>