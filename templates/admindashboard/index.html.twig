{% extends 'adminlayout.html.twig' %}

{% block content %}
<div class="container-fluid">
  <h3 class="mb-4">Dashboard</h3>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card shadow border-0" style="background: linear-gradient(135deg, #ff9a8b, #ff6a88); color: white;">
        <div class="card-body">
          <h5>Total Produce Prices</h5>
          <h2>₱ {{ totalSales|number_format(2, '.', ',') }}</h2>
          <p>Potential Growth by {{ salesGrowth }}%</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0" style="background: linear-gradient(135deg, #56ccf2, #2f80ed); color: white;">
        <div class="card-body">
          <h5>Total Products</h5>
          <h2>{{ productCount }}</h2>
          <p>In system database</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0" style="background: linear-gradient(135deg, #6a11cb, #2575fc); color: white;">
        <div class="card-body">
          <h5>Service Bookings</h5>
          <h2>{{ bookingCount }}</h2>
          <p>Total appointments booked</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0" style="background: linear-gradient(135deg, #43e97b, #38f9d7); color: white;">
        <div class="card-body">
          <h5>Registered Users</h5>
          <h2>{{ userCount }}</h2>  
          <p>Made Accounts</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.card {
  border-radius: 1rem;
  transition: transform 0.3s;
}
.card:hover {
  transform: translateY(-5px);
}
</style>
{% endblock %}
